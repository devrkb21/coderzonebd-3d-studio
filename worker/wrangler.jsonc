{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cz3d-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "LIMITER", "class_name": "Limiter" },
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Limiter", "Presence"] }],
  // Client project rooms (`?client=<token>`): one JSON record per client, keyed by a hash of the
  // token. Managed with `node scripts/client.mjs` (see the README). Also caches GitHub commits.
  "kv_namespaces": [{ "binding": "CLIENTS", "id": "b5033d765016499596f45684c21b6113" }],
  // Limits that protect the Anthropic credit. Change them here and redeploy.
  "vars": {
    "ALLOWED_ORIGINS": "https://3d.coderzonebd.com",
    "CHAT_MODEL": "claude-sonnet-5-5",
    "DEMO_MODEL": "claude-sonnet-5-5",
    "CHAT_PER_HOUR": "30",
    "DEMO_PER_HOUR": "5",
    "CHAT_PER_DAY": "600",
    "DEMO_PER_DAY": "60",
    "PROJECT_PER_HOUR": "60"
  }
}
